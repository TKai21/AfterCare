DATABASE_URL=mysql+asyncmy://aftercare:change_me@localhost:3306/aftercare
JWT_SECRET=please_change_me_to_a_long_random_value
JWT_EXPIRE_MINUTES=43200
LLM_API_BASE=https://api.openai.com/v1
# Any current chat model with tool calling, for example (OpenAI):
# LLM_MODEL=gpt-4.1-mini
LLM_MODEL=
LLM_API_KEY=
# JSON output on chat calls with tools: 1 on, 0 off; empty means on for api.openai.com only
LLM_JSON_WITH_TOOLS=
# Default to LLM_API_BASE / LLM_API_KEY when left empty
EMBEDDING_API_BASE=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
RAG_DB_PATH=knowledge/index.sqlite3
RAG_MIN_SIMILARITY=0.25
# Library reranker: 1 turns it on (needs manage_knowledge.py fetch-reranker first)
RERANK_ENABLED=0
RERANK_MODEL=ms-marco-MiniLM-L-6-v2
RAG_MIN_RERANK=-6.5
# Doctor guidance retrieval: the top K rules scoring at least FLOOR and within MARGIN of the best.
# (GUIDANCE_MIN_SIMILARITY, the floor's old name, is still read when GUIDANCE_FLOOR is unset.)
GUIDANCE_FLOOR=0.40
GUIDANCE_MARGIN=0.05
GUIDANCE_TOP_K=6
FOODS_PATH=data/foods.json
# Optional: private voice-file directory (relative to the project root).
# VOICE_STORAGE_PATH=private/voice

# De-identify every text sent to the model (docs/privacy.md). 0 turns it off,
# for a model that runs on a machine we control.
PRIVACY_MASKING=1

# The five-stage interview procedure (safety, symptoms, the doctor's follow-ups,
# medicines, wrap-up, then a summary the patient confirms). 0 keeps the shorter
# interview built only from the doctor's habits.
INTERVIEW_PROCEDURE=1
